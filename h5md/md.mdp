integrator = md
nsteps = 20
dt = 0.002
nstxout = 5
nstvout = 10
nstfout = 20
nstenergy = 0
nstlog = 0
cutoff-scheme = Verlet
coulombtype = PME
rcoulomb = 0.9
rvdw = 0.9
pbc = xyz
constraints = h-bonds
tcoupl = v-rescale
tc-grps = System
tau_t = 0.1
ref_t = 300
pcoupl = c-rescale
tau_p = 0.5
ref_p = 1.0
compressibility = 4.5e-5
gen_vel = yes
gen_temp = 300
gen_seed = 1
